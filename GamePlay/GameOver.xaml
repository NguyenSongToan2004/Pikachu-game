<Window x:Class="GamePlay.GameOver"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePlay"
        mc:Ignorable="d"
        Title="Game Over" Height="640" Width="650" Background="#FFCCC668" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <TextBlock Text="Game Over" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock x:Name="YourScoreTextBlock" Text="Your Score:" FontSize="24" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0 0 0 10">
                    <Image Source="https://png.pngtree.com/png-clipart/20230811/original/pngtree-ranking-medal-icon-illustration-2nd-place-silver-drawing-achievement-second-place-vector-picture-image_10347046.png" Width="80" />
                    <Label x:Name="No2" Content="Ten Nguoi Choi Hang 2" HorizontalContentAlignment="Center" FontWeight="ExtraBold"/>
                    <Label x:Name="No2Score" Content="0" Foreground="Green" HorizontalContentAlignment="Center" FontWeight="ExtraBold" Padding="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="25 0">
                    <Image Source="https://png.pngtree.com/png-vector/20220708/ourmid/pngtree-ranking-medal-icon-illustration-1st-place-gold-challenge-element-mark-vector-png-image_32573216.png" Width="80"/>
                    <Label x:Name="No1"  Content="Ten Nguoi Choi Hang 1" HorizontalContentAlignment="Center" FontWeight="ExtraBold" Padding="0 0 0 10"/>
                    <Label x:Name="No1Score" Content="0" Foreground="Green" HorizontalContentAlignment="Center" FontWeight="ExtraBold" Padding="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Image Source="https://png.pngtree.com/png-vector/20220708/ourmid/pngtree-ranking-medal-icon-illustration-3rd-place-bronze-celebration-ranking-sport-vector-png-image_32573192.png" Width="80"/>
                    <Label x:Name="No3"  Content="Ten Nguoi Choi Hang 3" HorizontalContentAlignment="Center" FontWeight="ExtraBold"/>
                    <Label x:Name="No3Score" Content="0" Foreground="Green" HorizontalContentAlignment="Center" FontWeight="ExtraBold" Padding="0"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="ScoreDataGrid" AutoGenerateColumns="False" Width="382" Height="179" Background="#FF2D9CDB" Foreground="Black" FontSize="18" Margin="0,0,0,20" AlternatingRowBackground="#FF085FA1" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Player Nickname" Binding="{Binding PlayerName}" Width="*"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*"/>
                </DataGrid.Columns>
               
                <DataGrid.RowStyle>
                    <Style  TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FF2D9CDB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF085FA1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <Button x:Name="btnHome" Content="Home" Width="126" Height="29" Background="#FF2D9CDB" Foreground="White" Cursor="Hand" FontSize="16" FontWeight="Bold" Click="btnHome_Click" Margin="0,10,0,0"/>
            <Button x:Name="btnRestart" Content="Restart" Width="128" Height="31" Background="#FF2D9CDB" Foreground="White" Cursor="Hand" FontSize="16" FontWeight="Bold" Click="btnRestart_Click" Margin="0,10,0,0"/>
            <Button x:Name="btnExit" Content="Exit" Width="126" Height="29" Background="#FF2D9CDB" Foreground="White" Cursor="Hand" FontSize="16" FontWeight="Bold" Click="btnExit_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
