<Window x:Class="GamePlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePlay"
        mc:Ignorable="d"
         Title="Game Pikachu" Height="800" Width="1010"   WindowStartupLocation="CenterScreen" Background="#FF4CCBB8" ResizeMode="NoResize" Icon="pack://application:,,,/Images/icon.ico" >
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu và thông tin game -->
        <StackPanel Orientation="Horizontal" Margin="10">

            <Button x:Name="btnNewGame" Content="New Game"  Click="btnNewGame_Click" Style="{StaticResource MenuButtonStyle}" />
            <Button x:Name="ShuffleButton" Content="Shuffle"  Click="ShuffleButton_Click"  Style="{StaticResource MenuButtonStyle}"/>
            <Button x:Name="btnMute" Content="Mute"  Style="{StaticResource MenuButtonStyle}" Click="btnMute_Click" />
            <Button x:Name="btnClose" Content="Close"  Style="{StaticResource MenuButtonStyle}" Click="btnClose_Click"/>


            <TextBlock Text="  Điểm: " FontSize="20" VerticalAlignment="Center"/>
            <TextBlock x:Name="ScoreText" Text="0" FontSize="20" VerticalAlignment="Center"/>
            <TextBlock Text="  Thời gian: " FontSize="20" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TimeText" Text="200" FontSize="20" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Khu vực chơi game -->
        <Viewbox Grid.Row="1" Margin="10" MaxWidth="1000" MaxHeight="500">
            <Canvas x:Name="GameCanvas"
               Grid.Row="1"
               ClipToBounds="True"
               Background="#FF085FA1"/>
        </Viewbox>
    </Grid>
</Window>
