<Window x:Class="GamePlay.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePlay"
        mc:Ignorable="d"
        Title="Login" Height="447" Width="704" WindowStartupLocation="CenterScreen" Background="#FFA1DC9F" ResizeMode="NoResize" Icon="pack://application:,,,/Images/icon.ico" >
    <Grid>
        <Image Source="pack://application:,,,/Images/pikachu.jpg" HorizontalAlignment="Center" VerticalAlignment="Top" Width="704" Height="495" Margin="0,10,0,0"/>
        <Label Content="Enter your name:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,324,0,0" Height="39" Width="172" RenderTransformOrigin="0.447,0.963"/>
        <TextBox x:Name="PlayerNameTextBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,364,0,0" Width="202" FontSize="16" Height="24"/>
        <Button Content="Play" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="47,344,0,0" Width="150" FontSize="16" Background="#FFD700" Foreground="Black" Cursor="Hand" Click="PlayButton_Click" Height="50"/>
        <Button Content="Quit" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="504,344,0,0" Width="150" FontSize="16" Background="#FF6347" Foreground="White" Cursor="Hand" Click="QuitButton_Click" Height="50"/>
    </Grid>
</Window>
